# ── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://muzakkir:muzakkir@localhost:5432/muzakkir"

# ── Auth ───────────────────────────────────────────────────
# 32+ random bytes. Used to sign session cookies (HMAC-SHA256).
SESSION_SECRET="change-me-to-a-long-random-string"

# ── Quran source ───────────────────────────────────────────
# "database"  → read verified text imported by `npm run db:seed:quran`
# "quran-com" → fetch from api.quran.com at runtime (cached), no DB needed
# "json"      → offline/dev: data/quran/*.json written by `npm run quran:cache`
QURAN_PROVIDER="quran-com"
QURAN_COM_API="https://api.quran.com/api/v4"
# QURAN_JSON_DIR="data/quran"
# TAFSIR_JSON_DIR="data/tafsir"
# Verse audio CDN (EveryAyah, Mishary Alafasy 128kbps)
NEXT_PUBLIC_AYAH_AUDIO_BASE="https://everyayah.com/data/Alafasy_128kbps"

# ── Speech-to-text (server side; never exposed to browser) ─
# "browser" → Web Speech API in the user's browser (no server cost)
# "openai"  → OpenAI transcription API (whisper-1 / gpt-4o-transcribe)
# "mock"    → deterministic test provider
NEXT_PUBLIC_STT_MODE="browser"
STT_PROVIDER="openai"
OPENAI_API_KEY=""
# whisper-1 returns word timestamps (needed for hesitation detection);
# gpt-4o-transcribe / gpt-4o-mini-transcribe return text only.
OPENAI_STT_MODEL="whisper-1"
# STT_PROMPT="off"               # off (default, measured) | domain | surah — generic context only, NEVER the expected ayah text
# STT_SECOND_OPINION=""          # e.g. gpt-4o-transcribe: an independent 2nd recognizer used as evidence (extra cost/latency)
# STT_TRACE="off"                # on = log transcript/alignment diagnostics (never audio, never keys)
# MOCK_STT_TEXT=""   # text returned by STT_PROVIDER=mock

# ── Assistant: trusted-web fallback (OPTIONAL, off by default) ──────────
# Only when ASSISTANT_WEB_SEARCH="on" (plus OPENAI_API_KEY) and ONLY for ordinary Islamic FACTUAL questions
# (history, sirah, people, terminology) that the approved local sources could not answer. Never for Quran/tafsir,
# hadith, fiqh/rulings, personal cases, asbab or off-topic questions. OpenAI Responses `web_search`, restricted to
# a small reviewed domain allow-list; answers always carry source links, or the assistant abstains.
# ASSISTANT_WEB_SEARCH="off"           # "on" enables it; off by default
# ASSISTANT_WEB_MODEL="gpt-5-mini"     # the domain filter needs a gpt-5-family model
# ASSISTANT_WEB_DAILY_CAP="150"        # max web calls per server instance per UTC day (per-client limit: 6 / 10 min)
# Comma-separated allow-list (default: islamweb.net, dorar.net, islamenc.com, dar-alifta.org):
# ASSISTANT_TRUSTED_DOMAINS=""

# ── LLM for the grounded assistant ─────────────────────────
# "anthropic" | "openai" | "extractive" (no LLM: returns retrieved sources only)
LLM_PROVIDER="extractive"
# Generation stays OFF even with an API key unless this is "on" (Level B questions only, always verified).
ASSISTANT_GENERATION="off"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
OPENAI_CHAT_MODEL="gpt-4o-mini"
# "openai" (text-embedding-3-small, 1536 dims → pgvector) | "none"
EMBEDDING_PROVIDER="openai"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ── Voice recordings ───────────────────────────────────────
# 0 = never stored (transcribe in memory, discard). >0 = days kept when the user opts in.
RECORDING_RETENTION_DAYS="0"
# Where opted-in recordings are kept (local disk; swap RecordingStore for S3/R2 in production)
RECORDINGS_DIR="data/recordings"
# Upload limit for /recitation/transcribe (bytes)
MAX_AUDIO_UPLOAD_BYTES="15728640"

# ── Web push (generate with `npx web-push generate-vapid-keys`) ─
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@example.com"

# ── Scheduled jobs ─────────────────────────────────────────
# POST /api/v1/cron/reminders with "Authorization: Bearer $CRON_SECRET" every 15 min.
CRON_SECRET=""
# Used for users who never sent their IANA time zone
DEFAULT_TIME_ZONE="Asia/Riyadh"

# Public site URL — used for absolute Open Graph / social preview links (optional in dev).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# DEV ONLY tools need a build with DEV_TOOLS=1 AND STT_BENCHMARK="on" (localhost only); a normal build excludes them
# CTC_CLIPS_DIR=""               # DEV ONLY: local folder for /dev/clip-recorder clips (offline CTC feasibility test)
# COACH_AI="on"                 # Session Coach message via OpenAI (needs OPENAI_API_KEY); "off" = deterministic template only
# COACH_MODEL=""                 # defaults to OPENAI_CHAT_MODEL
